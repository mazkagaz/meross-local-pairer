<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Cleartext is limited to the AP endpoint and local mDNS/LAN API
         hostnames. The local broker API is HTTP-only on port 2003. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.10.10.1</domain>
        <domain includeSubdomains="true">local</domain>
        <domain includeSubdomains="true">lan</domain>
    </domain-config>
</network-security-config>