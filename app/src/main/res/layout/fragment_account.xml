<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="16dp"
        tools:context=".ui.fragments.account.AccountFragment">

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/advancedModeSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="10dp"
        android:text="@string/text_advanced_settings" />

    <LinearLayout
        android:id="@+id/accountSectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/text_account_login"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/accountSectionArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_chevron_collapsed"
            android:textSize="18sp" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/httpInfoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10sp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/networkCardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_active_configuration_info"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textView21"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:text="@string/account_activity_logged_info" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/brokerHostInputLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4sp"
                android:hint="@string/hint_ha_address">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/brokerHostEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/httpsSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/text_use_https" />

            <TextView
                android:id="@+id/endpointSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/advancedBrokerFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/httpPortInputLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4sp"
                    android:hint="@string/hint_http_api_port">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/httpPortEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/httpsPortInputLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4sp"
                    android:hint="@string/hint_https_api_port">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/httpsPortEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:id="@+id/advancedSecrets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textField2"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4sp"
                        android:hint="@string/label_user_id">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/userIdEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/na"
                            android:textIsSelectable="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textField3"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4sp"
                        android:hint="@string/label_http_token">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/httpTokenEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/na"
                            android:textIsSelectable="true"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textField4"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4sp"
                        android:hint="@string/label_mqtt_key">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/mqttKeyEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/na"
                            android:textIsSelectable="true"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveBrokerButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/action_save_broker_address" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reloginButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_login_again"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/httpLogoutButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_logout" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/loginCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        tools:layout_editor_absoluteX="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10sp"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/haBrokerLoginButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_login_ha_broker" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/setManualButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="@string/action_manual_setup" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/wifiSectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/label_wifi_network"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wifiSectionArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_chevron_collapsed"
            android:textSize="18sp" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/allowedWifiCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10sp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/text_allowed_networks_help" />

            <TextView
                android:id="@+id/allowedWifiSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/text_no_network_validated" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/allowCurrentWifiButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_trust_current_wifi" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/manageAllowedWifiButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_manage_allowed_networks" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/diagnosticsSectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/text_pairing_diagnostics"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/diagnosticsSectionArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_chevron_collapsed"
            android:textSize="18sp" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/diagnosticsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10sp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/text_pairing_logs_help" />

            <TextView
                android:id="@+id/tlsPinSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/text_tls_pin_none" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resetTlsPinButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_reset_tls_pin" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/pairingDebugSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/action_enable_pairing_logs" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/copyPairingLogsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_copy_pairing_logs" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearPairingLogsButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_clear_pairing_logs" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>