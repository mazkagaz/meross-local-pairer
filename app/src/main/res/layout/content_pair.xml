<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    android:layout_marginTop="-6dp"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/appBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/pairer_banner" />

    <LinearLayout
        android:id="@+id/pairWifiLocationStatusLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF424242"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/pairWifiOffTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:drawableLeftCompat="@drawable/ic_signal_wifi_off_black_24dp"
            android:drawablePadding="5dp"
            android:text="@string/text_wifi_off"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/pairLocationOffTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:drawableLeftCompat="@drawable/ic_location_off_black_24dp"
            android:drawablePadding="5dp"
            android:text="@string/text_location_off"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/pairing_graph" />
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="8dp" />
</LinearLayout>
