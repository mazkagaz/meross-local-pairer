<string name="menu_about">About…</string>
    <string name="about_text_title">What it does</string>
    <string name="about_text_body">Pairs Meross devices with a local MQTT broker instead of the Meross cloud. Use it once per device; Home Assistant then controls the device on your local network.</string>
    <string name="about_version_format">Version %1$s</string>
